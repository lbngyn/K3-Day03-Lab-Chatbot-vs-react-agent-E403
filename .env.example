# =============================================================================
# ⚙️ CẤU HÌNH MULTI-PROVIDER LLM ADAPTER
# =============================================================================

# -----------------------------------------------------------------------------
# 📌 BƯỚC 1: CHỌN NHÀ CUNG CẤP AI (LLM_PROVIDER)
# Chọn 1 trong các giá trị sau: gemini | openai | anthropic | openrouter | mock
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai

# -----------------------------------------------------------------------------
# 📌 BƯỚC 2: ĐIỀN API KEY CHO PROVIDER ĐÃ CHỌN Ở BƯỚC 1
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# -----------------------------------------------------------------------------
# 📌 BƯỚC 3: (TÙY CHỌN) CẤU HÌNH URL CỦA PROVIDER (OPENAI_BASE_URL)
# Điền URL provider tùy chỉnh nếu dùng thư viện openai để gọi AI khác (Ollama, DeepSeek, LM Studio, Groq...)
# Ví dụ:
#   - DeepSeek API:    OPENAI_BASE_URL=https://api.deepseek.com
#   - Ollama Local:    OPENAI_BASE_URL=http://localhost:11434/v1
#   - LM Studio Local: OPENAI_BASE_URL=http://localhost:1234/v1
#   - Groq API:        OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   - OpenAI chính hãng: Để trống (OPENAI_BASE_URL=)
# -----------------------------------------------------------------------------
OPENAI_BASE_URL=

# -----------------------------------------------------------------------------
# 📌 BƯỚC 4: (TÙY CHỌN) GHI ĐÈ TÊN MODEL CỤ THỂ (LLM_MODEL)
# 
# 💡 Mặc định nếu ĐỂ TRỐNG (LLM_MODEL=), hệ thống tự dùng Model chuẩn của Provider:
#   - Nếu chọn LLM_PROVIDER=gemini     ➔ Mặc định dùng: gemini-2.5-flash
#   - Nếu chọn LLM_PROVIDER=openai     ➔ Mặc định dùng: gpt-4o-mini
#   - Nếu chọn LLM_PROVIDER=anthropic  ➔ Mặc định dùng: claude-3-haiku-20240307
#   - Nếu chọn LLM_PROVIDER=openrouter ➔ Mặc định dùng: google/gemini-2.5-flash
#
# ✏️ Ví dụ nếu muốn ĐỔI MODEL KHÁC / CUSTOM MODEL (Điền tên Model cụ thể vào sau dấu =):
# LLM_MODEL=gpt-4o
# LLM_MODEL=deepseek-chat
# LLM_MODEL=llama3.2
# -----------------------------------------------------------------------------
LLM_MODEL=

%% Hybrid Flowchart cho UI React Agent Dashboard
%% Khop voi ui/src/utils/reactAgentSimulator.js va ui/src/data/toolsRegistry.js

flowchart TD
    A["User Query"] --> B{"Mode / Intent"}

    %% Chatbot Baseline: phan hoi sach, khong goi tool
    B -->|"Baseline mode / cau hoi don gian"| C["CHATBOT BASELINE"]
    C --> D["processQuery(query, baseline)"]
    D --> E["Tra loi kien thuc tong quat"]
    E --> Z["Final Response"]
    D -.-> T["Trace Log"]

    %% ReAct Agent: phan tich yeu cau va chon tool tu registry
    B -->|"ReAct mode / cau hoi can tool"| F["REACT AGENT"]
    F --> G{"Loai yeu cau"}

    subgraph Tool_Registry ["Tool Registry"]
        H["find_houses(location, max_price)<br/>Input: khu vuc, ngan sach<br/>Output: danh sach can ho"]
        J["rerank(properties)<br/>Input: danh sach can ho<br/>Output: top_matches"]
        M["contact_sales(property_id, preferred_time, customer_phone)<br/>Input: can ho, thoi gian, SDT<br/>Output: booking_id, sales_contact"]
    end

    G -->|"Tim phong / can ho"| H
    H --> I{"Co ket qua?"}
    I -->|"Khong"| N["Safe response: khong tim thay can ho phu hop"]
    N --> Z
    I -->|"Co"| J
    J --> K["Hien thi danh sach can ho"]
    K --> L{"Nguoi dung chon dat lich?"}
    L -->|"Khong"| Z
    L -->|"Co"| M

    G -->|"Dat lich / xem nha"| M
    M --> P["Booking Sidebar: luu lich hen"]
    P --> Z

    G -->|"Cau hoi khac"| Q["Tra loi chao mung / huong dan"]
    Q --> Z

    %% Quan sat va guardrail duoc hien thi trong dashboard
    F -.-> R["Trace Log: Thought / Action / Observation"]
    C -.-> R
    H -.-> R
    J -.-> R
    M -.-> R
    R --> S["Guardrail config: MAX_ITERATIONS = 3"]
    S -->|"Vuot gioi han"| U["Safe Fallback"]
    U --> Z
%% Hybrid Flowchart - Chatbot Baseline vs ReAct Agent
%% Dong bo voi src/app.py, src/prompts.py va src/tools.py

flowchart TD
    A["User Query"] --> B{"Chon che do / Intent"}

    %% Chatbot Baseline: mot LLM call, khong goi tool
    B -->|"Baseline / kien thuc chung"| C["CHATBOT BASELINE"]
    C --> D["CHATBOT_BASELINE_PROMPT"]
    D --> E["Provider.generate()"]
    E --> F["Final Response"]
    F --> T["Trace / Observability"]

    %% ReAct Agent loop
    B -->|"ReAct / can du lieu thuc te hoac action"| R["REACT AGENT"]
    R --> H["Load conversation memory"]
    H --> I["Provider.generate(REACT_SYSTEM_PROMPT)"]
    I --> J{"LLM output"}

    J -->|"Final Answer"| K["Final Answer"]
    K --> T

    J -->|"Action"| L["parse_action_call()"]
    L --> M["execute_tool(tool_name, kwargs)"]

    subgraph Tool_Registry ["AVAILABLE_TOOLS / Tool Registry"]
        N["find_houses(transaction_type, price_min, price_max, region, area)<br/>Tim tin mua ban / cho thue"]
        O["crawl_web(url, query)<br/>Crawl va tach du lieu web"]
        P["rerank_houses(listings_json, preferences)<br/>Xep hang theo tieu chi"]
        Q["contact_sales(property_id, customer_name,<br/>customer_phone, appointment_date)<br/>Dat lich xem nha"]
    end

    M --> N
    M --> O
    M --> P
    M --> Q
    N --> S["Observation"]
    O --> S
    P --> S
    Q --> S
    S --> U["Append Observation vao conversation_history"]
    U --> V{"Con budget? step < MAX_ITERATIONS"}
    V -->|"Con"| I
    V -->|"Het / MAX_ITERATIONS = 4"| W["GUARDRAIL SAFE FALLBACK"]
    W --> T

    R -.-> T
    S -.-> T